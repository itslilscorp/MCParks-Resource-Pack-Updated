{
  "type": "component_format",
  "hook": "equippable",
  "modelPrefix": "mcparks_cit/g8/",
  "priority": 3,
  "items": [
    "minecraft:leather_leggings",
    "minecraft:leather_chestplate",
    "minecraft:leather_boots",
    "minecraft:leather_helmet"
  ],
  "parameters": {
    "format": "${item}_${color}_${damage}",
    "variables": {
      "item": {
        "property": "item_type",
        "transform": "discard_namespace"
      },
      "color": {
        "componentType": "minecraft:dyed_color",
        "transform": [
          "get_snbt",
          "sanitize",
          {
            "regex": "^(?:rgb)?([0-9]+)(?:show_in_tooltip.*)?$",
            "substitution": "$1"
          }
        ]
      },
      "damage": {
        "componentType": "minecraft:damage",
        "expect": "number",
        "fallback": "0"
      }
    }
  }
}
